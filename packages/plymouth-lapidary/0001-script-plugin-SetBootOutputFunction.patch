+/* Pass kernel (/dev/kmsg) and redirected console output to the theme line
+ * by line, with ANSI escape sequences stripped. */
+void script_lib_plymouth_on_boot_output (script_state_t             *state,
+                                         script_lib_plymouth_data_t *data,
+                                         const char                 *output,
+                                         size_t                      size)
+{
+        static char pending[4096];
+        static size_t pending_length = 0;
+        size_t i;
+
+        if (script_obj_is_null (data->script_boot_output_func))
+                return;
+
+        for (i = 0; i < size; i++) {
+                char c = output[i];
+
+                if (c == '\n' || c == '\r' || pending_length + 1 >= sizeof(pending)) {
+                        if (pending_length > 0) {
+                                script_obj_t *line_obj;
+                                script_return_t ret;
+
+                                pending[pending_length] = '\0';
+                                line_obj = script_obj_new_string (pending);
+                                ret = script_execute_object (state,
+                                                             data->script_boot_output_func,
+                                                             NULL,
+                                                             line_obj,
+                                                             NULL);
+                                script_obj_unref (line_obj);
+                                script_obj_unref (ret.object);
+                                pending_length = 0;
+                        }
+                        continue;
+                }
+
+                /* Drop ANSI CSI sequences: ESC [ ... <letter> */
+                if (c == '\033') {
+                        i++;
+                        if (i < size && output[i] == '[') {
+                                i++;
+                                while (i < size && !((output[i] >= 'A' && output[i] <= 'Z') ||
+                                                     (output[i] >= 'a' && output[i] <= 'z')))
+                                        i++;
+                        }
+                        continue;
+                }
+
+                if (c == '\t')
+                        c = ' ';
+                if ((unsigned char) c < 0x20)
+                        continue;
+
+                pending[pending_length++] = c;
+        }
+}
