#!/usr/bin/env bash
# Power-saving mode for watching video on the G14 OLED panel.
# Switches the internal panel to 1920x1200@60 with VRR "always"; turning it
# off restores the previous mode and VRR policy.
# Measured on this machine: about 3 W less while playing video, ~0.5 W at idle.
#
#   video-mode on            switch to video mode
#   video-mode off           restore the previous settings
#   video-mode               toggle
#   video-mode status        show the current state
#   video-mode with <cmd...> run a command in video mode, restore afterwards
set -u
OUT=${VIDEO_MODE_OUTPUT:-eDP-1}
MODE_VIDEO=${VIDEO_MODE:-1920x1200@60}
STATE=${XDG_RUNTIME_DIR:-/tmp}/video-mode.state

current_mode() { kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
  | grep -oE '[0-9]+x[0-9]+@[0-9.]+\*' | head -1 | tr -d '*' \
  | awk -F@ '{printf "%s@%d\n", $1, ($2+0.5)}'; }
current_vrr() { kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
  | grep -oP 'Vrr: \K\w+' | head -1; }

on() {
  [ -f "$STATE" ] && { echo "already on"; return 0; }
  local m v; m=$(current_mode); v=$(current_vrr)
  printf '%s\n%s\n' "$m" "$v" > "$STATE"
  kscreen-doctor "output.$OUT.mode.$MODE_VIDEO" >/dev/null 2>&1
  sleep 1
  kscreen-doctor "output.$OUT.vrrpolicy.always" >/dev/null 2>&1
  echo "video mode ON  ($MODE_VIDEO + VRR)   [previous: $m / VRR $v]"
}

off() {
  [ -f "$STATE" ] || { echo "already off"; return 0; }
  local m v; m=$(sed -n 1p "$STATE"); v=$(sed -n 2p "$STATE")
  [ -n "$m" ] && kscreen-doctor "output.$OUT.mode.$m" >/dev/null 2>&1
  sleep 1
  case "${v,,}" in
    never)     kscreen-doctor "output.$OUT.vrrpolicy.never" >/dev/null 2>&1 ;;
    automatic) kscreen-doctor "output.$OUT.vrrpolicy.automatic" >/dev/null 2>&1 ;;
    always)    kscreen-doctor "output.$OUT.vrrpolicy.always" >/dev/null 2>&1 ;;
  esac
  rm -f "$STATE"
  echo "video mode OFF (restored: $m / VRR $v)"
}

case "${1:-toggle}" in
  on)     on ;;
  off)    off ;;
  toggle) [ -f "$STATE" ] && off || on ;;
  status) echo "mode: $(current_mode)"; echo "VRR : $(current_vrr)"
          [ -f "$STATE" ] && echo "video mode: on" || echo "video mode: off" ;;
  with)   shift; [ $# -eq 0 ] && { echo "usage: video-mode with <command...>"; exit 1; }
          on; trap off EXIT INT TERM; "$@" ;;
  *)      sed -n '2,13p' "$0" ;;
esac
