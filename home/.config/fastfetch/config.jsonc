{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "->   ",
        "key": {
            "width": 21
        }
    },

  "logo": {
        "type": "auto",
        "width": 40,
        "padding": {
            "top": 2,
            "left": 2,
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m"
        },
        {
            "type": "title",
            "key": " USER/HOST    ",
            "format": "{user-name}@{host-name}",
            "keyColor": "yellow"
        },
        {
            "type": "os",
            "key": "├─  OS        ",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "├─  KERNEL    ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "├─ 󰏖 PACKAGES  ",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": "├─  TERMINAL  ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "╰─  SHELL     ",
            "keyColor": "yellow"
       },
        "break",
        {
            "type": "host",
            "key": "  COMPUTER    ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "├─  CPU       ",
            "showPeCoreCount": true,
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "├─ 󰍛 GPU       ",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "├─ 󰹑 DISPLAY   ",
            "keyColor": "green"
        },
        {
            "type": "sound",
            "key": "├─ 󰓃 SOUND     ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "├─ 󰍛 MEMORY    ",
            "keyColor": "green"
        },
        {
            "type": "swap",
            "key": "├─ 󰓡 SWAP      ",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "╰─  DISK      ",
            "keyColor": "green"
        },
        "break",
        {
            "type": "command",
            "key": "╭─ OS Age      ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "╰─ Uptime      ",
            "keyColor": "magenta"
        },
        "break",
    ]
}
