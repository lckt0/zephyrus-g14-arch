# mkinitcpio preset for the linux-lapidary kernel (CachyOS base + local amdgpu
# display fixes, see docs/04-custom-packages.md). Builds a UKI directly.

ALL_kver="/boot/vmlinuz-linux-lapidary"

PRESETS=('default')

default_uki="/boot/EFI/Linux/arch-linux-lapidary.efi"
default_options="--splash /boot/splash.bmp"

fallback_uki="/boot/EFI/Linux/arch-linux-lapidary-fallback.efi"
